generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Company {
  id          String       @id @default(uuid())
  name        String
  users       User[]
  clients     Client[]
  documents   Document[]
  preferences Preference[]
  activityLogs ActivityLog[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String
  role          String    @default("normal")
  company       Company   @relation(fields: [companyId], references: [id])
  companyId     String
  refreshTokens RefreshToken[]
  preferences  String?   // JSON stored as string in SQLite
  documents    Document[]
  activityLogs ActivityLog[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Client {
  id              String     @id @default(uuid())
  clientReferenceId String   
  name            String
  email           String
  company         Company    @relation(fields: [companyId], references: [id])
  companyId       String
  documents       Document[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([companyId, clientReferenceId])
}

model Document {
  id            String   @id @default(uuid())
  title         String
  content       String
  fileName      String?
  fileType      String?
  filePath      String?
  fileHash      String?
  status        String   @default("PENDING")
  metadata      String?  // JSON stored as string in SQLite
  client        Client   @relation(fields: [clientId], references: [id])
  clientId      String
  company       Company  @relation(fields: [companyId], references: [id])
  companyId     String
  user          User?    @relation(fields: [userId], references: [id])
  userId        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ActivityLog {
  id          String   @id @default(uuid())
  action      String
  description String
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  company     Company  @relation(fields: [companyId], references: [id])
  companyId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Preference {
  id        String   @id @default(uuid())
  key       String
  value     String   // JSON stored as string in SQLite
  company   Company  @relation(fields: [companyId], references: [id])
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RefreshToken {
  id        String    @id @default(uuid())
  token     String    @unique
  user      User      @relation(fields: [userId], references: [id])
  userId    String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
}
